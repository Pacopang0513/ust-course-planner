{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "候选排名 candidate_rank（Step 2 产物）",
  "type": "object",
  "required": ["top_n", "total_candidates", "courses"],
  "properties": {
    "generated_at": { "type": "string" },
    "top_n": { "type": "integer", "minimum": 0 },
    "total_candidates": { "type": "integer", "minimum": 0 },
    "rules": { "type": "object" },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "category", "rule_score"],
        "properties": {
          "code": { "type": "string", "examples": ["COMP 2011"] },
          "name": { "type": "string" },
          "credits": { "type": ["number", "null"] },
          "category": {
            "type": "string",
            "enum": ["major_required", "cc_required", "major_elective", "cc_elective", "free_elective"]
          },
          "source_groups": { "type": "array", "items": { "type": "object" } },
          "rule_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "breakdown": {
            "type": "object",
            "properties": {
              "category": { "type": "number" },
              "level": { "type": "number" },
              "urgency": { "type": "number" }
            }
          }
        }
      }
    },
    "truncated": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "rule_score": { "type": "number" },
          "category": { "type": "string" }
        }
      }
    }
  }
}
