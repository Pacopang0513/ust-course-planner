{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ustplan.local/schemas/curriculum.schema.json",
  "version": 1,
  "title": "Curriculum candidate index (prog-crs build output)",
  "type": "object",
  "required": ["program", "intake_year", "school", "title", "requirements"],
  "properties": {
    "program": {"type": "string", "description": "专业代码，如 PHYS"},
    "intake_year": {"type": "string"},
    "school": {"type": "string"},
    "title": {"type": "string"},
    "source": {
      "type": "object",
      "properties": {
        "file": {"type": "string"},
        "parsed_at": {"type": "string"}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "remarks": {"type": "array", "items": {"type": "string"}},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block", "name", "sections"],
        "properties": {
          "block": {"type": "string", "enum": ["major", "track", "option"]},
          "name": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}},
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name", "groups"],
              "properties": {
                "type": {"type": "string",
                         "enum": ["pre_major", "fundamental", "required", "elective", "other"]},
                "name": {"type": "string"},
                "groups": {
                  "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["subject", "note", "credits", "courses"],
                      "properties": {
                        "subject": {"type": "string"},
                        "note": {"type": "string"},
                        "credits": {"type": "string"},
                        "kind": {
                          "type": "string",
                          "enum": ["pool", "single"],
                          "description": "pool = 候选池（组头+Note，多选一/计数）；single = 单门课"
                        },
                        "areas": {"type": "array", "items": {"type": "string"}},
                        "courses": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["code", "title", "credits"],
                          "properties": {
                            "code": {"type": "string"},
                            "title": {"type": "string"},
                            "credits": {"type": "string"},
                            "area": {"type": "string"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
