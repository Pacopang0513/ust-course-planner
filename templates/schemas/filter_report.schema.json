{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ustplan.local/schemas/filter_report.schema.json",
  "version": 1,
  "title": "过滤报告 filter_report（Step 3 产物）",
  "type": "object",
  "required": ["session", "input_count", "kept_count", "removed_count", "kept", "removed"],
  "properties": {
    "generated_at": { "type": "string" },
    "session": { "type": "string", "examples": ["2610"] },
    "input_count": { "type": "integer", "minimum": 0 },
    "kept_count": { "type": "integer", "minimum": 0 },
    "removed_count": { "type": "integer", "minimum": 0 },
    "note": { "type": "string" },
    "overrides": { "type": "array", "items": { "type": "string" } },
    "kept": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "schedule_found", "filter_reasons"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "credits": { "type": ["number", "null"] },
          "category": { "type": ["string", "null"] },
          "bucket_id": { "type": ["string", "null"], "description": "所属栏位" },
          "bucket_quota": { "type": ["integer", "null"], "minimum": 1 },
          "prereq_reference": { "type": "boolean", "default": false },
          "schedule_found": { "type": "boolean" },
          "sections": { "type": "integer", "minimum": 0 },
          "filter_reasons": {
            "type": "array",
            "items": { "type": "string" },
            "description": "not_offered_this_year / prereq_not_met:xxx / prereq_unknown:xxx / excluded_by_passed:xxx / restricted:xxx / user_overridden"
          },
          "prereq": {
            "type": "object",
            "description": "pre-req 状态（Step 6 waiver_required 与报告）。含成绩要求（grading）：不存在（[]=无要求）/ 需要某 grading（逐条 met）/ 无法对照（met=null）",
            "properties": {
              "text": { "type": "string" },
              "met": { "type": ["boolean", "null"], "description": "null = 无法解析（课程或成绩要求），需 AI 复核" },
              "missing": { "type": "array", "items": { "type": "string" } },
              "grading": {
                "type": "array",
                "description": "成绩要求逐条（如 PHYS 1314 要求 PHYS 1312 达到某成绩）",
                "items": {
                  "type": "object",
                  "required": ["code", "required", "met"],
                  "properties": {
                    "code": { "type": "string" },
                    "required": { "type": "string", "description": "要求成绩（A/B/Pass 等）" },
                    "actual": { "type": "string", "description": "已修实际成绩（无记录为空串）" },
                    "met": { "type": ["boolean", "null"], "description": "null = 无成绩记录/格式未知，无法对照" }
                  }
                }
              }
            }
          },
          "exclusion": {
            "type": "object",
            "description": "EXCLUSION 互斥信息（planner 排课时强制检查）",
            "properties": {
              "text": { "type": "string" },
              "codes": { "type": "array", "items": { "type": "string" } },
              "conflicts_with_passed": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "schedule_found", "filter_reasons"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "credits": { "type": ["number", "null"] },
          "category": { "type": ["string", "null"] },
          "bucket_id": { "type": ["string", "null"] },
          "bucket_quota": { "type": ["integer", "null"], "minimum": 1 },
          "prereq_reference": { "type": "boolean", "default": false },
          "schedule_found": { "type": "boolean" },
          "sections": { "type": "integer", "minimum": 0 },
          "filter_reasons": { "type": "array", "items": { "type": "string" } },
          "exclusion": {
            "type": "object",
            "description": "EXCLUSION 互斥信息",
            "properties": {
              "text": { "type": "string" },
              "codes": { "type": "array", "items": { "type": "string" } },
              "conflicts_with_passed": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
