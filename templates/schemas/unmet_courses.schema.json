{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ustplan.local/schemas/unmet_courses.schema.json",
  "version": 1,
  "title": "未修课程 unmet_courses（Step 1 产物，bucket 化）",
  "type": "object",
  "required": ["courses"],
  "properties": {
    "generated_at": { "type": "string" },
    "program": { "type": "string" },
    "intake_year": { "type": "string" },
    "track": { "type": "string", "description": "所选 track/option 块名（无分支为空）" },
    "graduation_target_credits": { "type": "number", "minimum": 0 },
    "unmet_credits": {
      "type": "number",
      "minimum": 0,
      "description": "未修学分估算（按 bucket 配额聚合：quota × 桶内学分中位数，config → defaults.unmet_credit_mode 可切 min；不含 pre-req 参考课；学分缺失的桶不计入）"
    },
    "unmet_credits_unknown_count": {
      "type": "integer",
      "minimum": 0,
      "description": "学分缺失（未标学分）的未修课程数（按桶计数）"
    },
    "estimated_semesters_left": {
      "type": "integer",
      "minimum": 0,
      "description": "估算剩余学期数（4 年制 8 学期含当前学期；无法估算为 0）"
    },
    "credits_per_semester_estimate": {
      "type": ["number", "null"],
      "description": "未修学分 / 剩余学期（P3 目标学分参考建议；学分缺失或无法估算为 null）"
    },
    "buckets": {
      "type": "array",
      "description": "栏位元数据（bucket_id → 标签/类别/配额）",
      "items": {
        "type": "object",
        "required": ["bucket_id"],
        "properties": {
          "bucket_id": { "type": "string", "examples": ["major-required-0", "cc-47"] },
          "label": { "type": "string", "description": "如 'Common Core (A)' / 课程 code / pool subject" },
          "category": { "type": "string", "enum": ["major_required", "cc_required", "major_elective", "cc_elective", "free_elective", "minor_required", "minor_elective"] },
          "quota": { "type": "integer", "minimum": 1, "description": "该栏位需选的课程数（默认 1）" },
          "note": { "type": "string", "description": "requirement Note 原文" },
          "note_semantics": { "type": "string", "description": "note_eval 解析出的 Note 表达式形状（复杂 Note 如 FYP 组才有；AI 复核用，禁止手写求值器）" }
        }
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "category"],
        "properties": {
          "code": { "type": "string", "examples": ["COMP 2011"] },
          "name": { "type": "string" },
          "credits": { "type": ["number", "null"], "minimum": 0 },
          "category": { "type": "string", "enum": ["major_required", "cc_required", "major_elective", "cc_elective", "free_elective", "minor_required", "minor_elective"] },
          "bucket_id": { "type": "string", "description": "所属栏位（必修一门一桶 / 选修一 pool 一桶 / CC 一区域一桶 / 副修一池一桶）" },
          "bucket_quota": { "type": "integer", "minimum": 1 },
          "prereq_reference": { "type": "boolean", "default": false, "description": "pre-req 引用补录（仅参考，不评分不排课）" },
          "source_groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "block": { "type": "string" },
                "section": { "type": "string" },
                "group": { "type": "string" },
                "note": { "type": "string", "description": "curriculum Note 原文（OR/AND/计数语义）" }
              }
            }
          },
          "note_interpretation": {
            "type": "string",
            "description": "AI 对 Note 语义的解析结果（必修/候选池/计数）"
          }
        }
      }
    },
    "pre_enrolled": {
      "type": "array",
      "description": "学校预选课（Pre-Enroll，视为已确定不重复推荐）：带 bucket 归属，供 Step 5 评分 +20% 与 drop 建议",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "examples": ["COMP 2011"] },
          "name": { "type": "string" },
          "credits": { "type": ["number", "null"], "minimum": 0 },
          "category": {
            "type": "string",
            "enum": ["major_required", "cc_required", "major_elective", "cc_elective", "free_elective", "minor_required", "minor_elective", ""]
          },
          "bucket_id": { "type": "string", "description": "所属栏位（curriculum/CC 池内才有；否则空=自由选修）" },
          "bucket_quota": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    }
  }
}
