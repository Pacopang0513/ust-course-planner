{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ustplan.local/schemas/timetable_plan.schema.json",
  "version": 1,
  "title": "课程表方案 timetable_plan（Step 6 产物）",
  "type": "object",
  "required": ["plans"],
  "properties": {
    "session": { "type": "string", "examples": ["2610"] },
    "target_credits": { "type": "number", "description": "用户目标学分（12-18 之外提示 overload/下限）" },
    "generated_at": { "type": "string" },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plan_id", "courses", "total_credits"],
        "properties": {
          "plan_id": { "type": "string", "examples": ["plan-1"] },
          "label": { "type": "string" },
          "target_credits": { "type": "number", "description": "本方案的学分目标" },
          "courses": {
            "type": "array",
            "items": { "type": "string", "examples": ["COMP 2011"] }
          },
          "total_credits": {
            "type": "number",
            "description": "软约束：常规 12-18，超出（overload/下限）仅提示不拒绝"
          },
          "workload": { "type": "string", "enum": ["light", "medium", "heavy"] },
          "cc_credits": { "type": "number", "minimum": 0 },
          "major_credits": { "type": "number", "minimum": 0 },
          "elective_credits": { "type": "number", "minimum": 0 },
          "days_used": {
            "type": "array",
            "description": "每周有课的天（含预选课占用的天），如 ['Mon','Tue','Wed','Thu']",
            "items": { "type": "string" }
          },
          "free_days": {
            "type": "array",
            "description": "无课的工作日（周一至周五；周末默认无课不算），空 = 无法实现整天空闲",
            "items": { "type": "string" }
          },
          "meal_conflicts": {
            "type": "array",
            "description": "占用正餐保护时段的课程清单（prefer_meal_free 低权重偏好，仍可能发生）",
            "items": {
              "type": "object",
              "required": ["day", "meal"],
              "properties": {
                "day": { "type": "string", "examples": ["Wed"] },
                "meal": { "type": "string", "examples": ["午餐", "晚餐"] },
                "window": { "type": "string", "examples": ["12:00-14:00"] },
                "courses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": { "type": "string" },
                      "times": { "type": "string", "examples": ["12:00-13:20"] }
                    }
                  }
                }
              }
            }
          },
          "no_conflict": { "type": "boolean", "default": true },
          "must_take_inserted": { "type": "array", "items": { "type": "string" } },
          "pre_enroll_advice": {
            "type": "array",
            "description": "预选课 drop 建议：即便 +20% 加权评分仍低于本方案已选最低分（优先级低）；学校不建议 drop 预选课，坚持需 waiver",
            "items": {
              "type": "object",
              "required": ["code"],
              "properties": {
                "code": { "type": "string" },
                "name": { "type": "string" },
                "score": { "type": "number", "description": "预选课加权后评分" },
                "min_plan_score": { "type": "number", "description": "本方案已选课程最低分" },
                "reason": { "type": "string" },
                "note": { "type": "string", "description": "drop 风险提示（waiver / 预选资格）" }
              }
            }
          },
          "waiver_required": {
            "type": "array",
            "description": "pre-req 未满足/待确认课程（需教授豁免）",
            "items": {
              "type": "object",
              "required": ["code"],
              "properties": {
                "code": { "type": "string" },
                "prerequisites": { "type": "string" },
                "missing": { "type": "array", "items": { "type": "string" } },
                "grading": {
                  "type": "array",
                  "description": "pre-req 成绩要求（成绩不达标/无法对照时附上）",
                  "items": { "type": "object" }
                },
                "note": { "type": "string" }
              }
            }
          },
          "course_details": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "section"],
              "properties": {
                "code": { "type": "string" },
                "name": { "type": "string" },
                "category": { "type": "string" },
                "credits": { "type": ["number", "null"] },
                "bucket_id": { "type": "string" },
                "section": { "type": "string", "examples": ["L1", "L1 + T1B"] },
                "datetime": { "type": "string" },
                "room": { "type": "string" },
                "instructors": { "type": "array", "items": { "type": "string" } },
                "sections": {
                  "type": "array",
                  "description": "所选全部 section（tutorial 课程含 L + T 各一节）",
                  "items": {
                    "type": "object",
                    "required": ["section"],
                    "properties": {
                      "section": { "type": "string", "examples": ["L1"] },
                      "datetime": { "type": "string" },
                      "room": { "type": "string" },
                      "instructors": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                },
                "prerequisites": { "type": "string" },
                "prereq_met": { "type": ["boolean", "null"] },
                "prereq_missing": { "type": "array", "items": { "type": "string" } },
                "exclusions": {
                  "type": "array",
                  "description": "该课程 EXCLUSION 互斥课程（规范化课号；排课时已强制检查，此处供复核）",
                  "items": { "type": "string" }
                },
                "zero_credit": {
                  "type": "boolean",
                  "default": false,
                  "description": "0 学分课程（如 COMP 1991 实习）：无时间 section 时仅标注占位，不占排课时间"
                }
              }
            }
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
