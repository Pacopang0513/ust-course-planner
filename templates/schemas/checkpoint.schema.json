{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ustplan.local/schemas/checkpoint.schema.json",
  "version": 1,
  "title": "阶段检查点 checkpoint",
  "type": "object",
  "required": ["completed", "current", "updated_at"],
  "properties": {
    "completed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["phase1-input", "phase2-profile", "phase3-course-analysis", "phase4-report", "phase4.5-must-take"]
      }
    },
    "current": {
      "type": ["string", "null"],
      "enum": [null, "phase1-input", "phase2-profile", "phase3-course-analysis", "phase4-report", "phase4.5-must-take"]
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
