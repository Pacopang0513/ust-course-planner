{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AR↔curriculum mapping result",
  "type": "object",
  "required": ["program", "entries", "unmapped"],
  "properties": {
    "program": {"type": "string"},
    "intake_year": {"type": "string"},
    "generated_at": {"type": "string"},
    "summary": {
      "type": "object",
      "properties": {
        "mapped": {"type": "integer"},
        "cc_routed": {"type": "integer"},
        "unmapped": {"type": "integer"}
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ar_group", "ar_status", "candidates", "confidence", "method"],
        "properties": {
          "ar_group": {"type": "string"},
          "ar_status": {"type": "string"},
          "curriculum_block": {"type": "string"},
          "curriculum_group": {"type": "string"},
          "candidates": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "string",
                         "enum": ["explicit", "high", "medium", "low", "unmapped"]},
          "method": {"type": "string"},
          "evidence": {"type": "object"}
        }
      }
    },
    "cc_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ar_group", "channel"],
        "properties": {
          "ar_group": {"type": "string"},
          "ar_status": {"type": "string"},
          "channel": {"type": "string", "const": "cc"},
          "candidates": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ar_group"],
        "properties": {
          "ar_group": {"type": "string"},
          "ar_status": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
