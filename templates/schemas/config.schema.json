{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ustplan.local/schemas/config.schema.json",
  "version": 1,
  "title": "ustplan 统一配置 config/ustplan.json",
  "type": "object",
  "properties": {
    "$schema": { "type": "string", "description": "schema 自引用（允许，非业务字段）" },
    "session": {
      "type": ["string", "null"],
      "description": "目标学期 session（'latest'= 自动取最近；或 '2610' 固定；null = 由用户确认）",
      "examples": ["latest", "2610"]
    },
    "admission_year": {
      "type": ["string", "null"],
      "description": "入学年份（如 2026-27）；null = 运行时由画像推断",
      "examples": ["2026-27"]
    },
    "defaults": {
      "type": "object",
      "properties": {
        "target_credits": { "type": "number", "minimum": 0, "description": "用户默认目标学分" },
        "plans": { "type": "integer", "minimum": 1, "description": "课程表方案数量" },
        "top_per_bucket": { "type": "integer", "minimum": 1, "description": "每栏位取 Top N 进入总表" },
        "credits_min": { "type": "number", "description": "Regular Term 学分下限" },
        "credits_max": { "type": "number", "description": "学分上限（overload 需 Dean 批准）" },
        "candidate_pool": { "type": "integer", "minimum": 1, "description": "选课池取排名前 N" },
        "graduation_credits": { "type": "number", "minimum": 0, "description": "毕业总学分（4 年制默认 120；双主修等以 AR 为准）" },
        "unmet_credit_mode": { "type": "string", "enum": ["median", "min"], "description": "未修学分估算代表性学分：median（桶内中位数，默认）/ min（保守下限）" }
      },
      "additionalProperties": false
    },
    "planner": {
      "type": "object",
      "description": "step6 排课偏好（产品参数，可调）",
      "properties": {
        "prefer_day_off": {
          "type": "boolean",
          "default": true,
          "description": "整天空闲优先（高权重）：section 组合优先少用天数，尽力压缩出至少 1 个工作日无课"
        },
        "prefer_meal_free": {
          "type": "boolean",
          "default": true,
          "description": "正餐时段避让（低权重）：同等天数前提下优先避开午餐/晚餐时段"
        },
        "meal_windows": {
          "type": "array",
          "description": "正餐保护时段（分钟级解析 'HH:MM'）；与课程重叠即视为占用",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string", "examples": ["午餐", "晚餐"] },
              "start": { "type": "string", "examples": ["12:00"] },
              "end": { "type": "string", "examples": ["14:00"] }
            },
            "required": ["label", "start", "end"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "description": "评分公式 A+B+C+D 全部参数（产品参数，可调）",
      "properties": {
        "baseline": { "type": "number", "description": "评分基准线（2.5）" },
        "weights": {
          "type": "object",
          "description": "A/B/C/D 组件权重",
          "properties": {
            "a": { "type": "number" }, "b": { "type": "number" },
            "c": { "type": "number" }, "d": { "type": "number" }
          },
          "additionalProperties": false,
          "required": ["a", "b", "c", "d"]
        },
        "professor": {
          "type": "object",
          "description": "教授评分综合各维度权重",
          "additionalProperties": { "type": "number" }
        },
        "heat_tiers": {
          "type": "array",
          "description": "评论热度档位（降序 min_reviews → points）",
          "items": {
            "type": "object",
            "properties": {
              "min_reviews": { "type": "integer", "minimum": 0 },
              "points": { "type": "number" }
            },
            "required": ["min_reviews", "points"],
            "additionalProperties": false
          }
        },
        "min_reviews_for_score": { "type": "integer", "minimum": 1, "description": "评论数低于此值总分直接为 0" },
        "weight_penalty_per_missing": { "type": "number", "minimum": 0, "maximum": 1, "description": "评论数不足时每缺 1 条降权比例" },
        "level_bonus": {
          "type": "object",
          "description": "低阶必修加分百分比（课号千位 → %）",
          "additionalProperties": { "type": "number" }
        },
        "pre_enroll_boost": { "type": "number", "minimum": 0, "maximum": 1, "description": "预选课加分比例（默认 0.2 = 评分 ×1.2）" }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "description": "历史学期教授对照（step5.5，step6 消费）：往期教授评分明显优于本学期 → 本年度课程降权 + 延后建议",
      "properties": {
        "threshold": { "type": "number", "minimum": 0, "description": "触发降权的往期−本学期教授评分差（默认 0.5）" },
        "penalty_pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "降权比例（默认 10 = 总分 ×0.9，仅影响排序）" }
      },
      "additionalProperties": false
    },
    "jobs": {
      "type": "object",
      "description": "后台任务超时（分钟）",
      "additionalProperties": {
        "type": "object",
        "properties": { "timeout_minutes": { "type": "number", "minimum": 0 } },
        "required": ["timeout_minutes"],
        "additionalProperties": false
      }
    },
    "semesters": {
      "type": "object",
      "description": "学期 → session 尾号映射（{YY}{YY+1}{尾号}）",
      "additionalProperties": { "type": "number" }
    },
    "credentials": {
      "type": "object",
      "description": "凭据（cookie）管理参数",
      "properties": {
        "ttl_hours": { "type": "number", "minimum": 0.5, "description": "凭据有效期阈值（小时，默认 12）：超过后 --check/doctor/status 提示刷新" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
